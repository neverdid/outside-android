rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    function validAttendanceChange() {
      let oldAttendees = resource.data.attendeeIds.toSet();
      let newAttendees = request.resource.data.attendeeIds.toSet();
      let added = newAttendees.difference(oldAttendees);
      let removed = oldAttendees.difference(newAttendees);
      let joining = added.size() == 1
        && added.hasOnly([request.auth.uid])
        && removed.size() == 0
        && request.resource.data.going == resource.data.going + 1
        && request.resource.data.going <= resource.data.capacity;
      let leaving = removed.size() == 1
        && removed.hasOnly([request.auth.uid])
        && added.size() == 0
        && request.resource.data.going == resource.data.going - 1
        && request.resource.data.going >= 0;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['attendeeIds', 'going', 'updatedAt'])
        && (joining || leaving);
    }

    function validLikeChange() {
      let oldLikes = resource.data.likedBy.toSet();
      let newLikes = request.resource.data.likedBy.toSet();
      let added = newLikes.difference(oldLikes);
      let removed = oldLikes.difference(newLikes);
      let liking = added.size() == 1
        && added.hasOnly([request.auth.uid])
        && removed.size() == 0
        && request.resource.data.reactions == resource.data.reactions + 1;
      let unliking = removed.size() == 1
        && removed.hasOnly([request.auth.uid])
        && added.size() == 0
        && request.resource.data.reactions == resource.data.reactions - 1
        && request.resource.data.reactions >= 0;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likedBy', 'reactions', 'updatedAt'])
        && (liking || unliking);
    }

    match /users/{userId} {
      allow create, read, update: if isSelf(userId);
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.auth.uid in request.resource.data.attendeeIds
        && request.resource.data.going == 1
        && request.resource.data.capacity >= 2
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && request.resource.data.hostId == resource.data.hostId
        && (
          resource.data.hostId == request.auth.uid
          || validAttendanceChange()
        );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    match /feedPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.authorId == resource.data.authorId
        && (
          resource.data.authorId == request.auth.uid
          || validLikeChange()
        );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /forumTopics/{topicId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 50;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.moderationState == 'pending';
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
